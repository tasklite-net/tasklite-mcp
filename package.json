{
  "name": "@tasklite/mcp",
  "version": "0.16.0",
  "description": "TaskLite MCP server: build a full backend (projects, boards, data, REST endpoints), deploy a frontend onto it, and get a ready-made admin, from Claude Code and other MCP clients",
  "license": "MIT",
  "homepage": "https://tasklite.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tasklite-net/tasklite-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tasklite-net/tasklite-mcp/issues"
  },
  "mcpName": "net.tasklite/mcp",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "tasklite",
    "claude",
    "claude-code",
    "backend",
    "baas",
    "no-code"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "tasklite-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/tools.test.mjs",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "adm-zip": "^0.5.18",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
